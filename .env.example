# ---- AWS deploy credentials (used by the `aws`/`sam` CLI, not read by app code) ----
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
# Alternative to the two keys above, if you deploy via a named CLI profile instead
AWS_PROFILE=

# ---- SAM deploy parameters (passed as --parameter-overrides) ----
DEFAULT_USER_ID=demo-user

# ---- Cognito demo user (created manually post-deploy, used to test the orb login) ----
COGNITO_DEMO_EMAIL=you@example.com
COGNITO_DEMO_PASSWORD=ReplaceWithATempPassword1!

# ---- Stack outputs (fill in after `sam deploy`, from the Outputs section) ----
API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
OPENSEARCH_ENDPOINT=search-memoryos-search-xxxxxxxxxxxxxxxxxxxxxxxxxx.ap-south-1.es.amazonaws.com
MEMORIES_TABLE_NAME=memoryos-memories
ARTIFACTS_BUCKET_NAME=memoryos-artifacts-xxxxxxxxxxxx-ap-south-1

# ---- Groq (classification + reasoning; no Bedrock left in the stack) ----
# Free tier key from https://console.groq.com/keys
# Not consumed directly by the app — you push this into Secrets Manager after deploy:
#   aws secretsmanager put-secret-value --secret-id memoryos/groq-api-key --secret-string "{\"key\":\"$GROQ_API_KEY\"}"
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_ID=llama-3.3-70b-versatile
