{
  "manifest_version": 3,
  "name": "MemoryOS Orb",
  "version": "0.1.0",
  "description": "Proactive contextual memory for your browser.",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["orb.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "MemoryOS"
  }
}
